<!--
  The View-backed username field for WebAuthn conditional mediation: the androidx
  pendingGetCredentialRequest is View-only, so when the server marks the username callback
  with autocompleteValues ["username","webauthn"], the regular field is rendered from this
  layout and carries the pending request.
-->
<com.google.android.material.textfield.TextInputLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/webauthn_username_layout"
    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/webauthn_username_edit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="text"
        android:maxLines="1" />

</com.google.android.material.textfield.TextInputLayout>
