<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Notification permissions -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
      USE_FULL_SCREEN_INTENT lets the platform launch PushNotificationActivity directly when a
      push authentication request arrives while the screen is off or the device is locked. On
      Android 14+ (API 34) this permission is auto-granted only for phone/alarm apps; other apps
      (like this sample) get downgraded to a heads-up notification unless the user grants the
      "full-screen notifications" app-level toggle in Settings — that's a platform limitation.
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <application
        android:name=".PingOneSampleApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AuthApp">

        <activity
            android:name="com.pingidentity.samples.pingonesample.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AuthApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.pingidentity.samples.pingonesample.notification.PushNotificationActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <receiver
            android:name="com.pingidentity.samples.pingonesample.notification.NotificationActionReceiver"
            android:exported="false" />

        <service android:name="com.pingidentity.samples.pingonesample.service.PushNotificationService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
