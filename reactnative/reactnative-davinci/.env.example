# Build-time native settings only. All SDK runtime configuration (DaVinci,
# device authorization grant) is selected in the app from
# assets/configs/*.json presets or custom configs created on the
# Configuration screen; .env is not read by the app at runtime.

# TODO: Copy this file to `.env` and fill in the values for the features you use.
# All keys are optional: leave a feature's keys empty and that feature stays
# unconfigured (its screens show an actionable error).

# Facebook App config (external IdP / social login collector)
# Required on both platforms when a DaVinci flow includes a social login
# collector backed by Facebook.
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_LOGIN_PROTOCOL_SCHEME=fbyour-facebook-app-id
FACEBOOK_CLIENT_TOKEN=your-facebook-client-token

# Google client app iOS config (external IdP / social login collector)
# Required on iOS when a DaVinci flow includes a social login collector backed
# by Google. Android needs no app-side Google configuration: the Android SDK
# takes the Google client ID from the DaVinci social login connector in the flow.
GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com
GOOGLE_IOS_REVERSED_CLIENT_ID=com.googleusercontent.apps.your-google-ios-client-id

# Associated domain for passkey (FIDO2) credential delegation
# Required on both platforms when a DaVinci flow includes FIDO2 registration
# or authentication: Android builds it into asset_statements and iOS sets it
# as a webcredentials entitlement. It must match the domain registered with
# the Apple App ID capability (iOS) and the Digital Asset Links file (Android).
ASSOCIATED_DOMAIN=your-associated-domain.example.com
